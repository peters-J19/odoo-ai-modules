<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="schedule_review_wizard_view_form" model="ir.ui.view">
        <field name="name">helpdesk_ai_sorting.schedule_review_wizard.form</field>
        <field name="model">helpdesk_ai_sorting.schedule_review_wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule Review">
                <field name="ticket_id" invisible="1"/>
                <p>This will schedule a review activity with the reviewer and
                   deadline below. Adjust either if needed, then confirm.</p>
                <group>
                    <field name="assignee_id"/>
                    <field name="deadline"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
